# KUNCI AKSES BOT. Salin ke managed/.env lalu ganti 123456789 dengan ID kamu (README langkah 2).
# Dipasang read-only ke /etc/hermes/.env: dibaca Hermes PALING AKHIR dan menang atas data/.env, jadi agent
# tidak bisa melonggarkannya. Setelah diubah: docker compose restart
#
# Aturan isi: ID numerik (BUKAN @username), pisahkan koma tanpa spasi. JANGAN dikosongkan: nilai kosong
# masih bisa diisi dari data/config.yaml. Angka 0 = "tidak ada yang cocok".
# ID: Telegram -> chat ke @userinfobot; Discord -> Developer Mode -> Copy User ID.

# Semua platform: isi gabungan semua ID
GATEWAY_ALLOWED_USERS=123456789
GATEWAY_ALLOW_ALL_USERS=false

# Telegram
TELEGRAM_ALLOWED_USERS=123456789
TELEGRAM_GROUP_ALLOWED_USERS=123456789
TELEGRAM_GROUP_ALLOWED_CHATS=0
TELEGRAM_ALLOW_ALL_USERS=false

# Discord (kalau tidak dipakai, biarkan 0)
DISCORD_ALLOWED_USERS=0
DISCORD_ALLOWED_ROLES=0
DISCORD_ALLOW_ALL_USERS=false
DISCORD_ALLOW_BOTS=none
