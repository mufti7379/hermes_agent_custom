# Dashboard Hermes di belakang proxy Cloudflare (awan oranye). Pasang dengan (jangan `>>` manual):
#   bash caddy/pasang-situs.sh hermes.mufutirf.my.id caddy/hermes.caddy
# Syarat: caddy_ssl ada di jaringan "hermes-edge" (README langkah 1) dan Origin Certificate Cloudflare
# sudah ada di /data/cf-origin dalam container caddy_ssl (README 5d).
hermes.mufutirf.my.id {
	# Sertifikat ini hanya dipercaya Cloudflare: kalau awannya jadi abu-abu, browser akan menolak.
	tls /data/cf-origin/cert.pem /data/cf-origin/key.pem

	route {
		# Tolak yang tidak lewat Cloudflare (akses langsung ke IP VPS). Daftar: cloudflare.com/ips-v4
		@bukan_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
		abort @bukan_cloudflare

		# Lapis 1: login Caddy (popup browser) SEBELUM request sampai ke Hermes.
		# Hash: docker exec -it caddy_ssl caddy hash-password --algorithm bcrypt
		# Pakai password BERBEDA dari DASHBOARD_PASSWORD (lapis 2 = halaman login Hermes).
		basic_auth {
			admin HASH_BCRYPT
		}

		encode zstd gzip
		reverse_proxy hermes-dashboard:9119 {
			# Kredensial Caddy tidak perlu (dan tidak boleh) ikut sampai ke Hermes
			header_up -Authorization
		}
	}
}
