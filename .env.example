# Salin menjadi .env (JANGAN di-commit). Ini variabel untuk docker compose saja.
# API key LLM, TELEGRAM_BOT_TOKEN, dll. BUKAN di sini → ada di data/.env (ditulis `hermes setup`).

# Image. Pin ke versi tertentu untuk produksi (cek tag di hub.docker.com/r/nousresearch/hermes-agent).
# VPS Oracle Ampere (ARM64)? Pastikan tag punya arm64, kalau tidak build sendiri (README langkah 2b)
# lalu isi: HERMES_IMAGE=hermes-agent:local
HERMES_IMAGE=nousresearch/hermes-agent:stable

# Pemilik folder ./data di host. Jalankan `id -u` dan `id -g` sebagai user ubuntu. JANGAN 0 (root).
HERMES_UID=1001
HERMES_GID=1001

# Batas sumber daya gateway (VPS 12GB, dipakai bareng MySQL banksampah ±3GB + ResikforSchools ±1GB).
# 3g = total untuk gateway + dashboard (satu container), sisa perkiraan ±4GB cadangan.
# HERMES_CPUS: maksimal = hasil `nproc` dikurangi 1 (sisakan untuk MySQL).
HERMES_MEM_LIMIT=3g
HERMES_CPUS=1.0

# Siapa yang boleh memakai bot BUKAN di sini → managed/.env (template: managed.env.example)

# WAJIB. Login dashboard Hermes (lapis ke-2; lapis ke-1 = basic_auth Caddy).
# Password panjang & acak: openssl rand -hex 24 (simpan di password manager)
DASHBOARD_USER=
DASHBOARD_PASSWORD=
